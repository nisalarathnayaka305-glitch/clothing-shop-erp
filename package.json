{
  "name": "clothing-shop-erp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:accounting": "tsc -p accounting/tsconfig.json && vite build --config accounting/vite.config.ts",
    "build:all": "npm run build && npm run build:accounting && npm run build:leave",
    "build:leave": "tsc -p leave/tsconfig.json && vite build --config leave/vite.config.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0",
    "html5-qrcode": "2.3.8",
    "qrcode.react": "4.2.0",
    "jsbarcode": "^3.12.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.2",
    "vite": "^6.0.7",
    "@types/jsbarcode": "^3.11.3"
  }
}
